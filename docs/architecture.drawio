        <!-- Run lifecycle note -->
        <mxCell id="lifecycle" value="&lt;b&gt;Run lifecycle&lt;/b&gt;&lt;br&gt;&lt;br&gt;① Sign in (Cognito), describe a goal&lt;br&gt;&lt;br&gt;② Planner drafts a task graph (async)&lt;br&gt;&lt;br&gt;③ Review, edit, save as a versioned workflow&lt;br&gt;&lt;br&gt;④ Run now, or attach a rate / cron schedule&lt;br&gt;&lt;br&gt;⑤ Interpreter executes waves; workers fan out in parallel and call tools via the Gateway&lt;br&gt;&lt;br&gt;⑥ Outputs land in S3; status &amp;amp; tokens on the run record&lt;br&gt;&lt;br&gt;⑦ Report harness assembles the final artifact, noting gaps&lt;br&gt;&lt;br&gt;⑧ Browse runs &amp;amp; artifacts (presigned reads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="30" y="570" width="215" height="400" as="geometry" />
        </mxCell>

