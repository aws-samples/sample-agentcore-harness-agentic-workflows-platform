        <mxCell id="subtitle" value="All infrastructure is defined by the @agentic-platform CDK constructs · deployed to a single account in ap-southeast-2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#545B64;" vertex="1" parent="1">
