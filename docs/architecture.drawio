        <mxCell id="agentsNote" value="Workers are configuration, not code: model + instructions + tools + limits, validated at synth time. Least-privilege IAM role per harness. All harnesses call Bedrock models via regional inference profiles." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;" vertex="1" parent="1">
