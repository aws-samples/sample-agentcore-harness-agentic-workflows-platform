        <mxCell id="cw" value="CloudWatch&#10;dashboards + alarms" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="470" y="955" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="xray" value="X-Ray&#10;tracing" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="600" y="955" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="secNote" value="Least-privilege IAM per harness and per tool Lambda · runtime roles carry no control-plane permissions (the only resource ever created at runtime is a per-workflow EventBridge schedule; everything else exists only via CDK) · KMS encryption on artifacts, tables and logs · secrets never exposed to agents · cost-attribution tags (workload / component / env) on every resource · token usage captured on every run record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=8;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="700" y="925" width="810" height="140" as="geometry" />
        </mxCell>

