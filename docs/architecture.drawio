        <!-- Interpreter behaviour note -->
        <mxCell id="interpNote" value="&lt;b&gt;How a plan executes&lt;/b&gt;&lt;br&gt;One generic state machine runs any valid plan:&lt;br&gt;PrepareRun → per wave (sequential) → Map over tasks (parallel) → invokeHarness → PersistArtifact → EvaluateRunHealth → report → FinalizeRun&lt;br&gt;&lt;br&gt;Failure policies: contain (default) · fail-fast · retry-run. Failed tasks are recorded, dependents are skipped with a reason, and the report declares the gaps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D5B26A;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1235" y="710" width="285" height="175" as="geometry" />
        </mxCell>

        <!-- Security & observability -->
        <mxCell id="boxSec" value="Security &amp;amp; observability defaults — ObservabilityPack + AgenticFoundation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="300" y="910" width="1225" height="170" as="geometry" />
        </mxCell>
        <mxCell id="kms" value="KMS CMK&#10;per workload" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340" y="955" width="64" height="64" as="geometry" />
